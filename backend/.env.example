# CMMS Backend Environment Configuration
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.smmiw1z.mongodb.net/ConstructionDB?retryWrites=true&w=majority
NODE_ENV=development
# Long random secret for login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# Key that encrypts Site Store data in the database (at least 32 characters). It stays on
# the server only. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
# When replacing an existing key, see scripts/rotateEncryptionKey.js
ENCRYPTION_KEY=replace_with_32_or_more_random_characters

# Password for any of the six demo accounts that do not exist yet (must have 8+ characters,
# upper and lower case, a digit and a symbol). Existing accounts are never changed.
DEMO_USER_PASSWORD=

# Optional start-up switches
SEED_DEMO_DATA=false
RUN_STARTUP_TASKS=false

# Database Connection
# Set ALLOW_LOCAL_FALLBACK=true only if you explicitly want to fall back to local 127.0.0.1:27017 when Atlas is unreachable
ALLOW_LOCAL_FALLBACK=false

# Email / SMTP Configuration (Google Gmail or custom SMTP)
# Primary configuration:
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=elsconstruction2026@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=ELS Construction <elsconstruction2026@gmail.com>

# Backward-compatible aliases (also supported by mailer.js):
EMAIL_USER=elsconstruction2026@gmail.com
EMAIL_PASS=your_gmail_app_password

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CURRENCY=lkr
FRONTEND_URL=http://localhost:3000
