PORT=5000
# For local MongoDB, use: mongodb://127.0.0.1:27017/ConstructionDB
# For MongoDB Atlas, use: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ConstructionDB?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ConstructionDB
NODE_ENV=development
JWT_SECRET=cmms_secret_key_2024

# SMTP config used to email Purchase Orders to suppliers when a PO is sent.
# For testing without emailing real suppliers, use a Mailtrap sandbox inbox (mailtrap.io).
# For Gmail, set SMTP_SERVICE=gmail and use a Google Account App Password (not your login password).
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe payment gateway (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# From `stripe listen` (local dev) or the webhook endpoint's signing secret (production)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CURRENCY=lkr
# Used to build the Stripe Checkout success/cancel redirect URLs back to the frontend
FRONTEND_URL=http://localhost:3000
